#!/bin/busybox sh
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
mkdir -p /dev /proc /sys
mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sys /sys
exec >/dev/ttyS0 2>&1
set -exo pipefail
modprobe virtio_pci
modprobe virtio_blk
modprobe ext4
mode=install
delivery=network
for arg in $(cat /proc/cmdline); do case "$arg" in fleet.receipt=*) receipt=${arg#fleet.receipt=};; fleet.mode=*) mode=${arg#fleet.mode=};; fleet.delivery=*) delivery=${arg#fleet.delivery=};; esac; done
if [ "$delivery" = media ]; then
 # Virtual media: the boot medium carries nothing operation specific. The
 # config medium, rendered for one operation, carries the report token, the
 # bootstrap salt and payload, how the OS gets addresses, and where the
 # installed OS posts its report. The installer brings up no network and
 # reports nothing itself: only the installed OS's report proves the install.
 modprobe ata_piix || true
 modprobe sr_mod
 modprobe isofs
 config= boot=
 for _ in $(seq 1 30); do
  for dev in /dev/sr0 /dev/sr1; do
   [ -b "$dev" ] || continue
   if [ "$(dd if="$dev" bs=2048 count=1 2>/dev/null | head -c 15)" = FLEET-CONFIG-V1 ]; then config=$dev; else boot=$dev; fi
  done
  [ -n "$config" ] && [ -n "$boot" ] && break
  sleep 1
 done
 [ -n "$config" ] && [ -n "$boot" ] || /bin/busybox poweroff -f
 dd if="$config" bs=2048 count=4 2>/dev/null | tr -d '\000' > /fleet-config
 # The console is diagnostics only and must carry no secret: tracing
 # would print the token and the bootstrap payload, so it stays off for
 # the rest of a virtual media install.
 set +x
 value() { sed -n "s/^$1=//p" /fleet-config; }
 receipt=$(value token)
 salt=$(value salt)
 grep -qx 'addresses=DataNetwork' /fleet-config || /bin/busybox poweroff -f
 value bootstrap | base64 -d > /fleet-bootstrap
 report=$(value report)
 # The Machine's IPAM address, the only one the media service takes this
 # install's report from. A lab fault may add a stray address, inside the
 # site's ranges but not the Machine's, for one report with the right token.
 address=$(value reportaddress)
 stray=$(value straysource)
 case "$address" in *[!0-9.]*|'') /bin/busybox poweroff -f ;; esac
 case "$stray" in *[!0-9.]*) /bin/busybox poweroff -f ;; esac
 # The downloads the config medium pins, one "name digest" per line. This
 # lab image fetches nothing; it reports each one by the digest its
 # reference pins, as an installer that pulled it would.
 sed -n 's/^download=\([^ ]*\) [^@]*@\(sha256:[0-9a-f]*\)$/\1 \2/p' /fleet-config > /fleet-downloads
 [ ${#salt} = 64 ] || /bin/busybox poweroff -f
 # The image identity the boot medium carries: its own content manifest,
 # checked against the files it booted.
 mkdir -p /media
 mount -t iso9660 -o ro "$boot" /media
 (cd /media && sha256sum -c MANIFEST)
 image=$(sha256sum /media/MANIFEST | cut -d' ' -f1)
 umount /media
fi
[ ${#receipt} = 64 ] || /bin/busybox poweroff -f
if [ "$mode" = wipe ]; then
 # Redfish-mode cleanup environment: zero the whole disk, then verify by
 # reading it back. The receipt is printed only after the readback compared
 # equal. This is a logical overwrite of a virtual disk, not media sanitization.
 trap '/bin/busybox poweroff -f' EXIT
 size=$(($(cat /sys/block/vda/size) * 512))
 dd if=/dev/zero of=/dev/vda bs=4M count=$((size / 4194304)) conv=fsync
 sync
 echo 3 > /proc/sys/vm/drop_caches
 # This static BusyBox shell runs its own applets first. BusyBox cmp limits -n
 # to INT_MAX and takes skips positionally: compare 1 GiB chunks at offsets.
 off=0
 while [ "$off" -lt "$size" ]; do
  n=$((size - off)); [ "$n" -le 1073741824 ] || n=1073741824
  /bin/busybox cmp -n "$n" /dev/vda /dev/zero "$off" 0 || exit 1
  off=$((off + n))
 done
 printf 'FLEET-WIPED:%s:%s\n' "$receipt" "$size"
 sync
 exit 0
fi
[ "$mode" = install ] || /bin/busybox poweroff -f
printf 'label: dos\n, , L, *\n' | sfdisk /dev/vda
mkfs.ext4 -F /dev/vda1
mkdir -p /target
mount /dev/vda1 /target
# The payload is this pinned installer filesystem; exclude virtual mounts.
/bin/tar -cf - --exclude=./target --exclude=./proc --exclude=./sys --exclude=./dev --exclude=./out --exclude=./media --exclude=./fleet-config --exclude=./fleet-bootstrap --exclude=./fleet-downloads . | /bin/tar -xf - -C /target
mkdir -p /target/dev /target/proc /target/sys
mount --bind /dev /target/dev
mount --bind /proc /target/proc
mount --bind /sys /target/sys
if [ "$delivery" = media ]; then
 # What the installed OS reports at first boot, kept only on the target
 # disk; the console never carries the token.
 mkdir -m 0700 /target/fleet-report
 printf '%s' "$receipt" > /target/fleet-report/token
 printf '%s' "$report" > /target/fleet-report/url
 value reportca | base64 -d > /target/fleet-report/ca.pem
 cp /fleet-downloads /target/fleet-report/downloads
 printf '%s' "$address" > /target/fleet-report/address
 [ -z "$stray" ] || printf '%s' "$stray" > /target/fleet-report/stray
else
 printf '%s\n' "$receipt" > /target/fleet-receipt
fi
chroot /target grub-install --target=i386-pc /dev/vda
kernel=$(basename /boot/vmlinuz-*)
initrd=$(basename /boot/initrd.img-*)
cat > /target/boot/grub/grub.cfg <<CFG
set timeout=0
menuentry Fleet {
 linux /boot/$kernel root=/dev/vda1 ro console=ttyS0 init=/fleet-boot
 initrd /boot/$initrd
}
CFG
sync
if [ "$delivery" = media ]; then
 # Read the bootstrap payload back from the target disk, not from memory,
 # and report its digest salted for this operation.
 cp /fleet-bootstrap /target/fleet-bootstrap
 sync
 umount /target/dev /target/proc /target/sys
 umount /target
 echo 3 > /proc/sys/vm/drop_caches
 mount -o ro /dev/vda1 /target
 bootstrap=$({ printf '%s\n' "$salt"; cat /target/fleet-bootstrap; } | sha256sum | cut -d' ' -f1)
 umount /target
 mount /dev/vda1 /target
 printf 'sha256:%s' "$image" > /target/fleet-report/image
 printf 'sha256:%s' "$bootstrap" > /target/fleet-report/bootstrap
 sync
 umount /target
 echo 'fleet: virtual media installer finished'
 /bin/busybox poweroff -f
fi
printf 'FLEET-INSTALLED:%s\n' "$receipt"
/bin/busybox poweroff -f
