#!/bin/busybox sh
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
mount -t proc proc /proc 2>/dev/null || true
exec >/dev/ttyS0 2>&1
# Only the disk-root boot emits completion; installer completion is insufficient.
if grep -Eq '^/dev/vda1 / ext4 ' /proc/mounts && test -s /fleet-receipt; then
 printf 'FLEET-DISK-BOOT:%s\n' "$(cat /fleet-receipt)"
fi
# A virtual media install: at first boot the installed OS brings up its
# data network over DHCP, takes its IPAM address beside the lease, and posts
# its install report from that address over HTTPS, verifying the media
# service. The console shows only the outcome.
if grep -Eq '^/dev/vda1 / ext4 ' /proc/mounts && test -s /fleet-report/token; then
 mount -t sysfs sys /sys 2>/dev/null || true
 mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
 mount -t tmpfs tmpfs /run 2>/dev/null || true
 modprobe e1000 || true
 # The initramfs may rename the NIC; the data network is the one NIC.
 iface=$(ls /sys/class/net | grep -vx lo | head -n 1)
 /bin/busybox ip link set "$iface" up
 /bin/busybox udhcpc -i "$iface" -n -q -t 20 -s /fleet-dhcp >/dev/null 2>&1
 downloads=$(/bin/busybox awk 'BEGIN{ORS=""} {if (NR>1) print ","; printf "{\"name\":\"%s\",\"digest\":\"%s\"}", $1, $2}' /fleet-report/downloads 2>/dev/null)
 body=$(printf '{"token":"%s","image":"%s","bootstrap":"%s","downloads":[%s]}' "$(cat /fleet-report/token)" "$(cat /fleet-report/image)" "$(cat /fleet-report/bootstrap)" "$downloads")
 address=$(cat /fleet-report/address)
 /bin/busybox ip addr add "$address/32" dev "$iface"
 printf 'fleet: data network %s\n' "$(/bin/busybox ip -4 -o addr show dev "$iface" 2>&1 | /bin/busybox awk '{print $4}' | tr '\n' ' ')"
 post() { curl -sS -o /dev/null -w '%{http_code}' --interface "$1" --max-time 60 --retry 5 --retry-all-errors --cacert /fleet-report/ca.pem -H 'Content-Type: application/json' --data "$body" "$(cat /fleet-report/url)" 2>/run/curl.err || true; }
 # Lab fault: another server in the site's ranges posts this report, token
 # and all, first. The media service must refuse it for its address.
 if test -s /fleet-report/stray; then
  stray=$(cat /fleet-report/stray)
  /bin/busybox ip addr add "$stray/32" dev "$iface"
  printf 'fleet: stray report from %s HTTP %s\n' "$stray" "$(post "$stray")"
  /bin/busybox ip addr del "$stray/32" dev "$iface"
 fi
 status=$(post "$address")
 printf 'fleet: first-boot report from %s HTTP %s %s\n' "$address" "$status" "$(head -c 200 /run/curl.err)"
fi
sync
/bin/busybox poweroff -f
