#!/bin/busybox sh
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
mount -t proc proc /proc 2>/dev/null || true
exec >/dev/ttyS0 2>&1
# Only the disk-root boot emits completion; installer completion is insufficient.
if grep -Eq '^/dev/vda1 / ext4 ' /proc/mounts && test -s /fleet-receipt; then
 # Report the bootstrap data this system found on its own disk, by the
 # salted digest only, and only if the installer put it where the image
 # reads it.
 if test -s /fleet-bootstrap/data && cmp -s /fleet-bootstrap/authorized_keys /root/.ssh/authorized_keys &&
  cmp -s /fleet-bootstrap/user-data /var/lib/cloud/seed/nocloud/user-data; then
  printf 'FLEET-BOOTSTRAP:%s:sha256:%s\n' "$(cat /fleet-receipt)" "$(cat /fleet-bootstrap/salt /fleet-bootstrap/data | sha256sum | cut -d' ' -f1)"
 fi
 printf 'FLEET-DISK-BOOT:%s\n' "$(cat /fleet-receipt)"
fi
sync
/bin/busybox poweroff -f
